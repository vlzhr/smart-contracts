@Callable(i)
func stake() = {
  strict inv = invoke(Address(base58''), "mintLP", [], i.payments)

  []
}

@Callable(i)
func burnNFT() = {
  let tokenId = i.payments[0].value().assetId.value()
  let tokenIdStr = tokenId.toBase58String()

  strict playerId = getString(mintAddress, "nft_"+tokenIdStr+"_player").valueOrErrorMessage("not valid NFT")

  let burnForValue = calcBurnValue(tokenIdStr)

  [
    Burn(tokenId, 1),
    # ScriptTransfer(i.caller, burnForValue, unit),
    IntegerEntry("nft_"+tokenIdStr+"_burned", 1),
    IntegerEntry("player_"+tokenIdStr+"_burned", 1)
  ]
}

        
